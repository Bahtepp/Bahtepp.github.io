---
import type { MarkdownHeading } from 'astro';

import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Tags from '../components/Tags.astro';
import ShareLinks from '../components/ShareLinks.astro';
import { collectionMeta, type Post } from '../lib/content.ts';
import { formatDate, toISODate } from '../lib/format.ts';
import { formatReadingTime } from '../lib/reading-time.ts';

export interface Props {
	post: Post;
	headings: MarkdownHeading[];
	prev?: Post | undefined;
	next?: Post | undefined;
	/** Kısa içeriklerde (notlarda) içindekiler bölümü gösterilmez. */
	withToc?: boolean;
}

const { post, headings, prev, next, withToc = true } = Astro.props;
const { data } = post;

const canonicalUrl = new URL(post.url, Astro.site).href;
const section = collectionMeta[post.collection];
---

<BaseLayout
	title={data.title}
	description={data.description}
	type="article"
	image={data.image}
	imageAlt={data.imageAlt}
	publishedDate={data.date}
	modifiedDate={data.updatedDate}
	author={data.author}
	tags={data.tags}
	noindex={data.draft}
>
	<article class="article" data-pagefind-body>
		<header class="wrap article__header">
			<div class="article__header-inner">
				<p class="article__kicker">
					<a class="eyebrow" href={section.path} data-pagefind-meta={`kategori:${data.category}`}>
						{data.category}
					</a>
					{data.draft && <span class="draft-badge">Taslak</span>}
				</p>

				<h1 class="page-title">{data.title}</h1>
				<p class="article__lede">{data.description}</p>

				<!-- Tarih ve okuma süresi arama sonuçlarındaki özete karışmasın. -->
				<div class="meta article__meta" data-pagefind-ignore>
					<time datetime={toISODate(data.date)}>{formatDate(data.date)}</time>
					{
						data.updatedDate && (
							<span>
								Son güncelleme:{' '}
								<time datetime={toISODate(data.updatedDate)}>{formatDate(data.updatedDate)}</time>
							</span>
						)
					}
					<span>{formatReadingTime(post.readingTime)}</span>
					<span>{data.author}</span>
				</div>

				{data.tags.length > 0 && <div class="article__tags"><Tags tags={data.tags} /></div>}
			</div>
		</header>

		{
			data.image && (
				<div class="wrap article__cover-wrap">
					<img
						class="cover article__cover"
						src={data.image}
						alt={data.imageAlt ?? ''}
						loading="eager"
						decoding="async"
					/>
				</div>
			)
		}

		<div class="wrap article__body">
			{
				withToc && (
					<aside class="article__aside">
						<TableOfContents headings={headings} />
					</aside>
				)
			}

			<div class="article__content">
				<div class="prose">
					<slot />
				</div>

				<!--
					Etiketler yazı başlığının altında zaten dizine giriyor; buradaki tekrar ile
					paylaşım bağlantılarının arama sonuçlarına karışmasına gerek yok.
				-->
				<footer class="article__footer" data-pagefind-ignore>
					{data.tags.length > 0 && <Tags tags={data.tags} label="Etiketler" />}
					<ShareLinks title={data.title} url={canonicalUrl} />
				</footer>

				{
					(prev || next) && (
						<nav class="pager" aria-label="Diğer yazılar" data-pagefind-ignore>
							<div class="pager__cell">
								{prev && (
									<a class="pager__link" href={prev.url} rel="prev">
										<span class="eyebrow">Önceki yazı</span>
										<span class="pager__title">{prev.data.title}</span>
									</a>
								)}
							</div>
							<div class="pager__cell pager__cell--end">
								{next && (
									<a class="pager__link" href={next.url} rel="next">
										<span class="eyebrow">Sonraki yazı</span>
										<span class="pager__title">{next.data.title}</span>
									</a>
								)}
							</div>
						</nav>
					)
				}
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		--article-max: calc(var(--measure) + 19rem);
	}

	.article__header,
	.article__cover-wrap,
	.article__body {
		max-width: calc(var(--article-max) + 2 * var(--gutter));
	}

	.article__header {
		padding-block: clamp(2.5rem, 6vw, 4.5rem) 2.5rem;
	}

	.article__header-inner {
		max-width: var(--measure);
	}

	.article__kicker {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-block-end: 1.1rem;
	}

	.article__kicker a {
		text-decoration: none;
	}

	.article__kicker a:hover {
		color: var(--accent);
	}

	.article__lede {
		font-family: var(--font-serif);
		font-size: var(--step-1);
		line-height: 1.5;
		color: var(--text-muted);
		margin-block-start: 1.1rem;
	}

	.article__meta {
		margin-block-start: 1.6rem;
		padding-block-start: 1.1rem;
		border-block-start: 1px solid var(--rule);
	}

	.article__tags {
		margin-block-start: 1rem;
	}

	.article__cover-wrap {
		margin-block-end: 2.5rem;
	}

	.article__cover {
		max-width: var(--measure);
	}

	.article__body {
		display: grid;
		gap: 2.5rem;
	}

	.article__footer {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: var(--measure);
		margin-block-start: 4rem;
		padding-block-start: 1.25rem;
		border-block-start: 1px solid var(--rule-strong);
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem 2rem;
		max-width: var(--measure);
		margin-block-start: 3rem;
		padding-block-start: 1.5rem;
		border-block-start: 1px solid var(--rule);
	}

	.pager__cell--end {
		text-align: end;
	}

	.pager__link {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		text-decoration: none;
	}

	.pager__title {
		font-family: var(--font-serif);
		font-size: var(--step-0);
		line-height: 1.3;
	}

	.pager__link:hover .pager__title {
		color: var(--accent);
	}

	@media (max-width: 34rem) {
		.pager {
			grid-template-columns: 1fr;
		}

		.pager__cell--end {
			text-align: start;
		}
	}

	/* Masaüstünde içindekiler, metnin sağında sabit bir kolonda durur. */
	@media (min-width: 64rem) {
		.article__body {
			grid-template-columns: minmax(0, var(--measure)) minmax(0, 15rem);
			gap: 0 4rem;
			align-items: start;
		}

		.article__content {
			grid-column: 1;
			grid-row: 1;
			min-width: 0;
		}

		.article__aside {
			grid-column: 2;
			grid-row: 1;
			position: sticky;
			top: 5.5rem;
			max-height: calc(100vh - 8rem);
			overflow-y: auto;
			overscroll-behavior: contain;
		}
	}
</style>
