---
// Açık/koyu tema düğmesi. Tercih localStorage içinde saklanır.
---

<button
	type="button"
	id="theme-toggle"
	class="theme-toggle"
	aria-label="Temayı değiştir"
	title="Temayı değiştir"
>
	<svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<circle cx="12" cy="12" r="4.2"></circle>
		<path d="M12 2v2.6M12 19.4V22M2 12h2.6M19.4 12H22M4.9 4.9l1.9 1.9M17.2 17.2l1.9 1.9M19.1 4.9l-1.9 1.9M6.8 17.2l-1.9 1.9"
		></path>
	</svg>
	<svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path d="M20 14.4A8.6 8.6 0 1 1 9.6 4a7 7 0 0 0 10.4 10.4Z"></path>
	</svg>
</button>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		color: var(--text-muted);
		transition: color 0.15s ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
	}

	.icon {
		grid-area: 1 / 1;
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Açık temada ay, koyu temada güneş simgesi gösterilir. */
	:global([data-theme='light']) .icon--sun,
	:global([data-theme='dark']) .icon--moon {
		display: none;
	}
</style>

<script>
	const toggle = document.getElementById('theme-toggle');

	toggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;

		try {
			localStorage.setItem('bahtep-theme', next);
		} catch {
			// Depolama kapalıysa tercih kaydedilmez, tema yine de değişir.
		}
	});
</script>
