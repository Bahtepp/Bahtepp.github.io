---
import { siteConfig, navigation } from '../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header">
	<div class="wrap header__inner">
		<a class="wordmark" href="/">{siteConfig.siteName}</a>

		<nav class="nav" aria-label="Ana menü">
			<ul class="nav__list">
				{
					navigation.map((item) => (
						<li>
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header__actions">
			<ThemeToggle />
			<button
				type="button"
				id="menu-toggle"
				class="menu-toggle"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<span class="visually-hidden">Menü</span>
				<span class="menu-toggle__bars" aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<nav id="mobile-menu" class="mobile-menu" aria-label="Mobil menü" hidden>
		<ul class="wrap mobile-menu__list">
			{
				navigation.map((item) => (
					<li>
						<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		background-color: color-mix(in oklab, var(--bg) 88%, transparent);
		backdrop-filter: saturate(1.4) blur(10px);
		border-block-end: 1px solid var(--rule);
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 3.6rem;
	}

	.wordmark {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
	}

	.wordmark:hover {
		color: var(--accent);
	}

	.nav__list {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		list-style: none;
		padding: 0;
	}

	.nav a {
		font-size: var(--step--1);
		color: var(--text-muted);
		text-decoration: none;
		padding-block: 0.5rem;
	}

	.nav a:hover {
		color: var(--text);
	}

	/* Aktif bölüm ince bir çizgiyle işaretlenir. */
	.nav a[aria-current='page'] {
		color: var(--text);
		box-shadow: inset 0 -1px 0 var(--accent);
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-inline-start: auto;
	}

	.menu-toggle {
		display: none;
		width: 2.1rem;
		height: 2.1rem;
		place-items: center;
		color: var(--text-muted);
	}

	.menu-toggle__bars,
	.menu-toggle__bars::before,
	.menu-toggle__bars::after {
		display: block;
		width: 1.05rem;
		height: 1px;
		background-color: currentColor;
	}

	.menu-toggle__bars::before,
	.menu-toggle__bars::after {
		content: '';
		position: relative;
	}

	.menu-toggle__bars::before {
		top: -5px;
	}

	.menu-toggle__bars::after {
		top: 4px;
	}

	.menu-toggle[aria-expanded='true'] {
		color: var(--accent);
	}

	.mobile-menu {
		border-block-start: 1px solid var(--rule);
	}

	.mobile-menu__list {
		list-style: none;
		padding-block: 0.5rem 1rem;
	}

	.mobile-menu a {
		display: block;
		font-size: var(--step-0);
		text-decoration: none;
		padding-block: 0.7rem;
		border-block-end: 1px solid var(--rule);
		color: var(--text-muted);
	}

	.mobile-menu li:last-child a {
		border-block-end: none;
	}

	.mobile-menu a[aria-current='page'] {
		color: var(--text);
	}

	@media (max-width: 52rem) {
		.nav {
			display: none;
		}

		.menu-toggle {
			display: grid;
		}
	}

	/* Menü mobilde açık bırakılıp pencere büyütülürse masaüstünde görünmez. */
	@media (min-width: 52.0625rem) {
		.mobile-menu {
			display: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		menu?.toggleAttribute('hidden', open);
	});
</script>
