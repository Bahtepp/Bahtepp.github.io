---
import { getSiteLinks, siteConfig } from '../site.config.ts';

const year = new Date().getFullYear();
const social = getSiteLinks();
---

<footer class="footer">
	<div class="wrap footer__inner">
		<p class="footer__meta">
			© {year} {siteConfig.author}
		</p>

		<nav class="footer__nav" aria-label="Alt menü">
			<a href="/etiketler/">Etiketler</a>
			<a href="/arama/">Arama</a>
			<a href="/rss.xml">RSS</a>
			{social.map((link) => <a href={link.url}>{link.label}</a>)}
		</nav>
	</div>
</footer>

<style>
	.footer {
		border-block-start: 1px solid var(--rule);
		margin-block-start: 6rem;
		padding-block: 2rem 3rem;
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem 2rem;
	}

	.footer__meta {
		font-size: var(--step--1);
		color: var(--text-faint);
	}

	.footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}

	.footer__nav a {
		font-size: var(--step--1);
		color: var(--text-muted);
		text-decoration: none;
	}

	.footer__nav a:hover {
		color: var(--accent);
	}
</style>
