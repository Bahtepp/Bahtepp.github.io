---
import { siteConfig } from '../site.config.ts';
import '../styles/global.css';

export interface Props {
	title: string;
	description?: string;
	/** 'article' ise Open Graph ve JSON-LD makale olarak işaretlenir. */
	type?: 'website' | 'article';
	image?: string;
	imageAlt?: string;
	publishedDate?: Date;
	modifiedDate?: Date;
	author?: string;
	tags?: readonly string[];
	/** Arama motorlarının dizine eklememesi gereken sayfalar için. */
	noindex?: boolean;
}

const {
	title,
	description = siteConfig.description,
	type = 'website',
	image = siteConfig.defaultImage,
	imageAlt,
	publishedDate,
	modifiedDate,
	author = siteConfig.author,
	tags = [],
	noindex = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome
	? `${siteConfig.siteName} — ${siteConfig.tagline}`
	: `${title} — ${siteConfig.siteName}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				url: canonical.href,
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
				datePublished: publishedDate?.toISOString(),
				dateModified: (modifiedDate ?? publishedDate)?.toISOString(),
				inLanguage: siteConfig.lang,
				keywords: tags.length ? tags.join(', ') : undefined,
				image: imageUrl,
				author: { '@type': 'Person', name: author, url: new URL('/hakkimda/', Astro.site).href },
				publisher: { '@type': 'Person', name: siteConfig.author },
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: siteConfig.siteName,
				description: siteConfig.description,
				url: new URL('/', Astro.site).href,
				inLanguage: siteConfig.lang,
				author: { '@type': 'Person', name: siteConfig.author },
			};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${siteConfig.siteName} — RSS`}
	href="/rss.xml"
/>

<!-- Open Graph -->
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:site_name" content={siteConfig.siteName} />
<meta property="og:title" content={isHome ? siteConfig.siteName : title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={siteConfig.locale} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{
	type === 'article' && publishedDate && (
		<meta property="article:published_time" content={publishedDate.toISOString()} />
	)
}
{
	type === 'article' && modifiedDate && (
		<meta property="article:modified_time" content={modifiedDate.toISOString()} />
	)
}
{type === 'article' && <meta property="article:author" content={author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- X / Twitter Card -->
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={isHome ? siteConfig.siteName : title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

<!--
	Tema, CSS boyanmadan önce belirlenir. Böylece sayfa açılırken
	yanlış temanın kısa süreli görünmesi engellenir.
-->
<script is:inline>
	(() => {
		try {
			const saved = localStorage.getItem('bahtep-theme');
			const theme =
				saved === 'light' || saved === 'dark'
					? saved
					: window.matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light';
			document.documentElement.dataset.theme = theme;
		} catch {
			document.documentElement.dataset.theme = 'light';
		}
	})();
</script>
