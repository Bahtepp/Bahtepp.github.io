---
import ListingLayout from '../layouts/ListingLayout.astro';
---

<ListingLayout
	title="Arama"
	intro="Başlık, açıklama, kategori, etiket ve yazı metni içinde ara."
	noindex={true}
>
	<form class="search" role="search" id="search-form">
		<label class="visually-hidden" for="search-input">Arama terimi</label>
		<input
			class="search__input"
			type="search"
			id="search-input"
			name="q"
			placeholder="Örneğin: yapay zekâ"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
		/>
	</form>

	<p class="search__status" id="search-status" role="status" aria-live="polite"></p>

	<ul class="post-list search__results" id="search-results" hidden></ul>
</ListingLayout>

<style>
	.search {
		max-width: var(--measure);
	}

	.search__input {
		width: 100%;
		background-color: transparent;
		border: none;
		border-block-end: 1px solid var(--rule-strong);
		font-family: var(--font-serif);
		font-size: var(--step-2);
		padding-block: 0.6rem;
	}

	.search__input::placeholder {
		color: var(--text-faint);
	}

	.search__input:focus {
		outline: none;
		border-block-end-color: var(--accent);
	}

	.search__input:focus-visible {
		outline: none;
	}

	.search__status {
		font-family: var(--font-sans);
		font-size: var(--step--1);
		color: var(--text-muted);
		margin-block: 1.5rem;
		min-height: 1.5em;
	}

	.search__results {
		margin-block-start: 1rem;
	}

	/* Pagefind, eşleşen kelimeleri <mark> ile işaretler. */
	.search__results :global(mark) {
		background-color: var(--accent-subtle);
		color: inherit;
		font-style: normal;
	}
</style>

<!--
	`is:inline` bilinçli bir tercih: Pagefind dosyası build çıktısında oluştuğu için
	paketleyicinin bu import'u çözümlemeye çalışmaması gerekir. Bu yüzden script
	olduğu gibi, sade JavaScript olarak sayfaya gömülür.
-->
<script is:inline type="module">
	const form = document.getElementById('search-form');
	const input = document.getElementById('search-input');
	const status = document.getElementById('search-status');
	const list = document.getElementById('search-results');

	if (form && input && status && list) {
		form.addEventListener('submit', (event) => event.preventDefault());

		let api;

		/**
		 * Arama dizini `npm run build` sırasında Pagefind tarafından üretilir.
		 * Bu yüzden `npm run dev` sırasında dosya bulunmaz ve kullanıcıya bilgi verilir.
		 */
		async function loadPagefind() {
			if (api !== undefined) return api;

			try {
				const module = await import('/pagefind/pagefind.js');
				if (module.init) await module.init();
				api = module;
			} catch {
				api = null;
			}

			return api;
		}

		const escapeHtml = (value) =>
			String(value).replace(
				/[&<>"]/g,
				(ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch],
			);

		function render(items) {
			list.innerHTML = items
				.map((item) => {
					const title = escapeHtml(item.meta?.title ?? 'Başlıksız');
					const category = item.meta?.kategori ? escapeHtml(item.meta.kategori) : '';
					const head = category
						? `<div class="post-item__head"><span class="eyebrow">${category}</span></div>`
						: '';

					return `<li><a class="post-item" href="${escapeHtml(item.url)}">${head}<h2 class="post-item__title">${title}</h2><p class="post-item__desc">${item.excerpt ?? ''}</p></a></li>`;
				})
				.join('');

			list.hidden = items.length === 0;
		}

		async function runSearch(term) {
			const query = term.trim();

			if (query.length < 2) {
				render([]);
				status.textContent = query.length === 0 ? '' : 'En az iki harf yaz.';
				return;
			}

			const pagefind = await loadPagefind();

			if (!pagefind) {
				status.textContent =
					'Arama dizini bulunamadı. Arama, yayınlanmış sitede çalışır; yerelde denemek için "npm run build" ve ardından "npm run preview" komutlarını kullan.';
				return;
			}

			status.textContent = 'Aranıyor…';
			const search = await pagefind.debouncedSearch(query);

			// Daha yeni bir arama başladıysa bu sonuç geçersizdir.
			if (search === null) return;

			const items = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));
			render(items);

			status.textContent =
				items.length === 0 ? `"${query}" için sonuç bulunamadı.` : `${items.length} sonuç bulundu.`;
		}

		input.addEventListener('input', () => {
			runSearch(input.value);
		});

		// /arama/?q=... biçimindeki adresler doğrudan aramayı başlatır.
		const initial = new URLSearchParams(window.location.search).get('q');
		if (initial) {
			input.value = initial;
			runSearch(initial);
		}

		input.focus();
	}
</script>
